cc_binary {
    name: "flingboost",
    system_ext_specific: true,
    init_rc: ["flingboost.rc"],
    srcs: ["flingboost.cpp"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
