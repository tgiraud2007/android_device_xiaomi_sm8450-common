# The camera HAL probes /data/local/tmp and /data at start-up for debug
# configuration that is not needed at runtime
dontaudit hal_camera_default { shell_data_file system_data_file }:dir search;

# The audio HAL reads the boot status property on init; vendor domains are
# not allowed to read it and the value is not needed
dontaudit hal_audio_default boot_status_prop:file r_file_perms;
